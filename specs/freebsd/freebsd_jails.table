table_name("freebsd_jails")
description("FreeBSD jails. Jails can be nested, with parent_jid referencing the containing jail's jid (0 for root jails).")
schema([
    Column("jid", INTEGER, "Jail ID"),
    Column("parent_jid", INTEGER, "Parent jail ID (0 if this is a root jail)"),
    Column("name", TEXT, "Jail name"),
    Column("path", TEXT, "Root path of the jail"),
    Column("hostname", TEXT, "Jail hostname"),
    Column("ip4_addresses", TEXT, "Comma-separated list of assigned IPv4 addresses"),
    Column("ip6_addresses", TEXT, "Comma-separated list of assigned IPv6 addresses"),
    Column("securelevel", INTEGER, "Jail securelevel (-1 to 3)"),
    Column("devfs_ruleset", INTEGER, "Devfs ruleset number"),
    Column("enforce_statfs", INTEGER, "Restrict statfs: 0=all mounts visible, 1=only jail subtree, 2=only jail mount point"),
    Column("children_cur", INTEGER, "Current number of child jails"),
    Column("children_max", INTEGER, "Maximum number of child jails allowed"),
    Column("cpuset_id", INTEGER, "CPU set ID assigned to this jail"),
    Column("dying", INTEGER, "1 if jail is in the process of being removed"),
    Column("persist", INTEGER, "1 if jail exists without any processes"),
])
implementation("freebsd/freebsd_jails@genFreebsdJails")
